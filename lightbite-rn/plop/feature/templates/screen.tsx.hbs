import { useEffect } from 'react';
import { ActivityIndicator, FlatList, Text, View } from 'react-native';

import { useTheme } from '@/core/hooks/useTheme';
import { EmptyState } from '@/core/ui/EmptyState';
import { ErrorDisplay } from '@/core/ui/ErrorDisplay';

import { use{{pascalName}} } from '../hooks/use{{pascalName}}';
import type { {{pascalName}}Item } from '../types';

export default function {{pascalName}}Screen() {
  const { screenState, refresh } = use{{pascalName}}();
  const theme = useTheme();

  useEffect(() => {
    refresh();
  }, [refresh]);

  if (screenState.status === 'loading') {
    return (
      <View style=\{{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
        <ActivityIndicator size="large" color={theme.colors.primary[500]} />
      </View>
    );
  }

  if (screenState.status === 'error') {
    return <ErrorDisplay message={screenState.message} onRetry={refresh} />;
  }

  if (screenState.status === 'empty') {
    return <EmptyState message="No items found" />;
  }

  return (
    <FlatList
      data={screenState.data}
      keyExtractor={(item: {{pascalName}}Item) => item.uuid}
      renderItem={({ item }: { item: {{pascalName}}Item }) => (
        <Text>{item.uuid}</Text>
      )}
      contentContainerStyle=\{{ padding: theme.spacing.md }}
    />
  );
}
