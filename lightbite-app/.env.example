# LightBite Environment Configuration
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# Environment: development | staging | production
ENV=development

# API base URLs
DEVELOPMENT_BASE_URL=http://localhost:8001/api/v1
STAGING_BASE_URL=https://staging-api.lightbite.com/api/v1
PRODUCTION_BASE_URL=https://api.lightbite.com/api/v1

# WebSocket URLs
DEVELOPMENT_WS_URL=ws://localhost:8001/ws
STAGING_WS_URL=wss://staging-ws.lightbite.com
PRODUCTION_WS_URL=wss://ws.lightbite.com

# Sentry DSN (crash reporting)
SENTRY_DSN=

# Google Maps API key (required for location picker map view)
# Get a key at: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE

# Feature flags
ENABLE_API_LOGGING=true
ENABLE_CRASH_REPORTING=false
